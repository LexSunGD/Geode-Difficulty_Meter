{
	"geode": "6.0.0-alpha.1",
	"gd": {
		"win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
	},
	"id": "lexsungd.difficulty_meter",
	"version": "1.0.0",
	"name": "Difficulty Meter",
	"developer": "LexSunGD",
	"description": "Add difficulty faces based on the percentage of the level.",
	"repository": "https://github.com/LexSunGD/Geode-Difficulty_Meter",
	"tags": ["interface", "utility", "offline"],
	"resources": {
		"sprites": [
			"resources/*.png"
		]
	},
	"settings": {
		"disable-mod": {
			"name": "Disable Mod",
			"description": "If this is enabled, the Meter will not be displayed.",
			"type": "bool",
			"default": false
		},
		"meter-scale": {
			"name": "Meter Scale",
			"description": "Adjust the size of the difficulty faces.",
			"type": "float",
			"default": 1.2,
			"min": 0.1,
			"max": 5.0
		},
		"meter-pos-x": {
			"name": "Position X (Offset)",
			"description": "Position of the X-axis (horizontal).",
			"type": "int",
			"default": 270,
			"min": -500,
			"max": 500
		},
		"meter-pos-y": {
			"name": "Position Y (Offset)",
			"description": "Position of the y-axis (vertical).",
			"type": "int",
			"default": -70,
			"min": -300,
			"max": 300
		},
		"meter-opacity": {
			"name": "Opacity",
			"description": "Opacity of difficulty faces.",
			"type": "int",
			"default": 100,
			"min": 0,
			"max": 100
		}
	}
}
